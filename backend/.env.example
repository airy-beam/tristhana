# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Local development uses the DEV bot; prod values live only in GCP Secret Manager.
APP_ENV=dev                  # dev | test | prod
LOG_LEVEL=INFO
# LOG_FORMAT=console         # json | console (default: console in dev, json elsewhere)

# Added by upcoming Phase 0 tasks:
# TELEGRAM_BOT_TOKEN=        # @tristhana_dev_bot token from BotFather
# TELEGRAM_WEBHOOK_SECRET=   # e.g. `openssl rand -hex 32`
# DATABASE_URL=postgresql+asyncpg://tristhana:tristhana@localhost:5432/tristhana
