# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Local development uses the DEV bot; prod values live only in GCP Secret Manager.
APP_ENV=dev                  # dev | test | prod
LOG_LEVEL=INFO
# LOG_FORMAT=console         # json | console (default: console in dev, json elsewhere)

# Telegram: local dev uses long polling with the DEV bot (never the prod token).
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=          # @tristhana_dev_bot token from BotFather

# Added by upcoming tasks:
# DATABASE_URL=postgresql+asyncpg://tristhana:tristhana@localhost:5432/tristhana

# Postgres (ID-01). Local: podman Postgres, see backend/README.md. Prod: Secret Manager.
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:5432/tristhana
DATABASE_CA_FILE=
# Dev only: lets the Mini App browser mock sign initData. Keep off when tunnelling.
DEV_INIT_DATA=false
