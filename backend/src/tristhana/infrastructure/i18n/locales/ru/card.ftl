# ST-07: карточки для сторис (ADR-0040). Их читают другие люди, поэтому текст ни к кому не
# обращается (без «ты», «твой») и только называет факты. Без эмодзи: значки рисует карточка.
card-footer = Tristhana · @tristhana_bot
card-month-practices =
    { $count ->
        [one] { $count } день практики { $month ->
            [1] в январе
            [2] в феврале
            [3] в марте
            [4] в апреле
            [5] в мае
            [6] в июне
            [7] в июле
            [8] в августе
            [9] в сентябре
            [10] в октябре
            [11] в ноябре
           *[12] в декабре
        }
        [few] { $count } дня практики { $month ->
            [1] в январе
            [2] в феврале
            [3] в марте
            [4] в апреле
            [5] в мае
            [6] в июне
            [7] в июле
            [8] в августе
            [9] в сентябре
            [10] в октябре
            [11] в ноябре
           *[12] в декабре
        }
       *[many] { $count } дней практики { $month ->
            [1] в январе
            [2] в феврале
            [3] в марте
            [4] в апреле
            [5] в мае
            [6] в июне
            [7] в июле
            [8] в августе
            [9] в сентябре
            [10] в октябре
            [11] в ноябре
           *[12] в декабре
        }
    }
card-month-time =
    { $hours ->
        [0] { $minutes } мин на коврике
       *[other] { $minutes ->
            [0] { $hours } ч на коврике
           *[other] { $hours } ч { $minutes } мин на коврике
        }
    }
card-series-name =
    { $n ->
        [1] Первая серия
        [2] Вторая серия
        [3] Третья серия (Advanced A)
        [4] Четвёртая серия (Advanced B)
        [5] Пятая серия (Advanced C)
       *[6] Шестая серия (Advanced D)
    }
card-year-so-far =
    { $count ->
        [one] С начала { $year } года: { $count } практика
        [few] С начала { $year } года: { $count } практики
       *[many] С начала { $year } года: { $count } практик
    }
card-year-done =
    { $count ->
        [one] { $count } практика за { $year } год
        [few] { $count } практики за { $year } год
       *[many] { $count } практик за { $year } год
    }
card-legend-practice = практика
card-legend-moon = лунный день
card-new-asana = Новая асана
card-series-begins =
    { $n ->
        [1] Начинается первая серия
        [2] Начинается вторая серия
        [3] Начинается третья серия
        [4] Начинается четвёртая серия
        [5] Начинается пятая серия
       *[6] Начинается шестая серия
    }
card-series-complete =
    { $n ->
        [1] Первая серия целиком
        [2] Вторая серия целиком
        [3] Третья серия целиком
        [4] Четвёртая серия целиком
        [5] Пятая серия целиком
       *[6] Шестая серия целиком
    }
card-count =
    { $count ->
        [one] практика на коврике
        [few] практики на коврике
       *[many] практик на коврике
    }
card-series-other-name =
    { $n ->
        [3] Advanced A
        [4] Advanced B
        [5] Advanced C
       *[6] Advanced D
    }
