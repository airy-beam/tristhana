{
  "components": {
    "schemas": {
      "Day": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DayStatus"
          }
        },
        "required": [
          "date",
          "status"
        ],
        "title": "Day",
        "type": "object"
      },
      "DayStatus": {
        "enum": [
          "practiced",
          "rest",
          "moon",
          "ladies",
          "sick",
          "travel",
          "skipped"
        ],
        "title": "DayStatus",
        "type": "string"
      },
      "DayStatusBody": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/DayStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "DayStatusBody",
        "type": "object"
      },
      "Days": {
        "properties": {
          "days": {
            "description": "Logged days only, oldest first",
            "items": {
              "$ref": "#/components/schemas/Day"
            },
            "title": "Days",
            "type": "array"
          },
          "timezone_known": {
            "description": "False: today comes from a provisional zone",
            "title": "Timezone Known",
            "type": "boolean"
          },
          "today": {
            "description": "The caller's local date (server-computed)",
            "format": "date",
            "title": "Today",
            "type": "string"
          }
        },
        "required": [
          "today",
          "timezone_known",
          "days"
        ],
        "title": "Days",
        "type": "object"
      },
      "DeviceTimezone": {
        "properties": {
          "timezone": {
            "description": "Intl.DateTimeFormat().resolvedOptions()",
            "maxLength": 64,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone"
        ],
        "title": "DeviceTimezone",
        "type": "object"
      },
      "Error": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          }
        },
        "required": [
          "code"
        ],
        "title": "Error",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "auth_missing",
          "auth_invalid",
          "auth_expired",
          "invalid_timezone",
          "invalid_range",
          "date_in_future",
          "date_too_early",
          "unavailable"
        ],
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "commit"
        ],
        "title": "Health",
        "type": "object"
      },
      "Locale": {
        "enum": [
          "en",
          "ru"
        ],
        "type": "string"
      },
      "Me": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "IANA zone, e.g. Asia/Almaty; null until set",
            "title": "Timezone"
          }
        },
        "required": [
          "id",
          "display_name",
          "locale",
          "timezone"
        ],
        "title": "Me",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "TelegramInitData": {
        "description": "`tma <raw Telegram initData>` (ADR-0015)",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Tristhana API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Liveness check. Touches no external services, so it stays fast on a cold start.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "TelegramInitData": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/days": {
      "get": {
        "description": "Defaults to the 7 days ending today; at most 371 days per request.",
        "operationId": "list_days_api_v1_me_days_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Days"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "TelegramInitData": []
          }
        ],
        "summary": "List Days",
        "tags": [
          "days"
        ]
      }
    },
    "/api/v1/me/days/{date}": {
      "delete": {
        "description": "Idempotent: 204 even if nothing was logged.",
        "operationId": "delete_day_api_v1_me_days__date__delete",
        "parameters": [
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "TelegramInitData": []
          }
        ],
        "summary": "Delete Day",
        "tags": [
          "days"
        ]
      },
      "put": {
        "operationId": "put_day_api_v1_me_days__date__put",
        "parameters": [
          {
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DayStatusBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Day"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "TelegramInitData": []
          }
        ],
        "summary": "Put Day",
        "tags": [
          "days"
        ]
      }
    },
    "/api/v1/me/device-timezone": {
      "post": {
        "description": "Stores the device zone only if none is set yet; returns the account either way.",
        "operationId": "post_device_timezone_api_v1_me_device_timezone_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceTimezone"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "TelegramInitData": []
          }
        ],
        "summary": "Post Device Timezone",
        "tags": [
          "me"
        ]
      }
    }
  }
}
